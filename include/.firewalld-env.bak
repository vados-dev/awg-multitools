### Переменные для управления firewalld:
########################################
# Альяс команды firewall-cmd
FW_RUN=$(which firewall-cmd)
#-> Основные команды:
fw() {
  local output; output=$($FW_RUN "$@" 2>&1);
  ! [[ "$output" == "success" ]] && echo "$output"
  echo "$output" | grep -q 'success' && success_box "$FW_RUN $* $(cecho Gs 'success')." || log_error "${FW_RUN}\n$*\n${output}!"
}
fwreload() { fw --reload; }

# Ещё альясы
perm="--permanent"
rr="-rich-rules"

#-> Аргументы для обработки:
#arg1=${1:-""}; arg2=${2:-""}; arg3=${3:-""}; arg4=${4:-""};

### функции проверок:
#####################
fw_check_xml() { ! command -v grep "error" | /etc/firewalld/tools/check.sh >&2 || return 1; }

#show_command() { printf "    $(cecho Ws "Запуск") $(cecho Gs '%s') $(cecho Ws 'c аргументами: [') $(cecho Ys '%s')$(cecho Ws '].')\n" "$*" "$@"; }

### функции:
############
FW_lst() {
    local what="$1" name="$2"
    [[ "$#" == 1 ]] && fw "${lst}${what}"
    [[ "$#" == 2 ]] && fw "${lst}${what}${name}"
}

