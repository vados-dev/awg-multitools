#FW_check_port() { $FW_RUN --get-zones | xargs -n1 $FW_RUN --zone={} --list-ports | grep -qx "$1" && return 0 || return 1; }
#FW_check_port_perm() { $FW_RUN ${perm} --get-zones | xargs -n1 $FW_RUN ${perm} --zone={} --list-ports | grep -qx "$1" && return 0 || return 1; }

FW_check_port_perm() {
  local port="$1" found=1
  while IFS= read -r zone; do
    if firewall-cmd --permanent --zone="$zone" --list-ports 2>/dev/null | grep -qx "$port"; then
      found=0
      break
    fi
  done < <(firewall-cmd --permanent --get-zones 2>/dev/null)
  return "$found"
}


1FW_check_port() {
  local port="$1"
  local found=1
  # 1. Проверяем runtime (текущие правила)
  for zone in $(${FW_RUN} --get-zones 2>/dev/null); do
    if ${FW_RUN} --zone="$zone" --list-ports 2>/dev/null | grep -qx "$port"; then
      found=0
      break
    fi
  done
  # Если уже нашли — можно не проверять permanent
  [[ $found -eq 0 ]] && return 0
  # 2. Если не нашли в runtime — проверяем permanent (сохранённые правила)
  for zone in $(firewall-cmd ${perm} --get-zones 2>/dev/null); do
    if ${FW_RUN} ${perm} --zone="$zone" --list-ports 2>/dev/null | grep -qx "$port"; then
      found=0
      break
    fi
  done
  return "$found"
}

FW_check_port() {
  local port="$1" found=1
  # Проверяем и runtime, и permanent
  for mode in "" "${perm}"; do
    for zone in $(${FW_RUN} $mode --get-zones 2>/dev/null); do
      # 1. Прямой порт в зоне
      if ${FW_RUN} $mode --zone="$zone" --list-ports 2>/dev/null | grep -qw "$port"; then
        found=0
        break 2
      fi
      # 2. Порт внутри сервиса
      for svc in $(${FW_RUN} $mode --zone="$zone" --list-services 2>/dev/null); do
        if ${FW_RUN} $mode --service="$svc" --get-ports 2>/dev/null | grep -qw "$port"; then
          found=0
          break 3
        fi
      done
    done
  done
  return "$found"
}


FW_Zone() {
    local action="$1" name="$2" short="$3" desc="$4" dbg=1
    [ "$dbg" -eq 1 ] && log_debug "$? $*"
    if [[ "$action" = "--delete" ]]; then
        fw ${perm} "${action}-zone=${name}" || true
        fwreload
    fi
    if [[ "$action" = "--new" ]]; then
        fw ${perm} "${action}-zone=${name}" || true
        if [[ "$short" != "" ]]; then
            fw ${perm} "--zone=${name}" "--set-short=${short}"
        fi
        if [[ "$desc" != "" ]]; then
            fw ${perm} "--zone=${name}" "--set-description=${desc}"
        fi
        fwreload
    fi
    if [[ "$action" = "--list" ]]; then
        if [[ "$name" != "" ]]; then
            fw --list-zone="$name"
        else
            fw "--list-$*"
        fi
    fi
    if [[ "$action" = "--get" ]]; then
        if [[ "$name" != "" ]]; then
            fw --get-zone="$name"
        else
            fw --get$*
        fi
    fi
}

function list-all {
  ${fwcmd} $lst$rr
  firewall-cmd --get-active-zones
  firewall-cmd --get-default-zone
  firewall-cmd --get-zones
  return=$?
}


