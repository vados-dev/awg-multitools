#-> Помогаторы:
menu_pause() { echo ""; _read_line "$(cecho sW '    Нажмите Enter для возврата в меню...')" _; }
#-> Главное меню и меню разделов:
show_menu() {
    wg_header
    while true; do
        local choice
        local index=0
        printf "${blub}╔%s╗${nc}\n" "$(align::center $COLS_NUM "$equals ${mTitle} $equals")"
        printf "${blub}║%s║${nc}\n" "$(align::center $COLS_NUM " ")"
        for idx in ${!mItems[@]}; do
            printf "${blub}║%s║${nc}\n" "$(align::left $COLS_NUM "  $((idx + 1))  -  ${mItems[$idx]}")"
            index=$((index + 1))
        done
        printf "${blub}║ ${und}%s${nc}${blub} ║${nc}\n" "$(align::center $((COLS_NUM-2)) ' ')"
        printf "${magb}║%s║${nc}\n" "$(align::center $COLS_NUM " ")"

        if [[ "$mType" != "main" ]]; then
            printf "${magb}║%s║${nc}\n" "$(align::left $COLS_NUM " 0  -  Назад")"
        fi

        printf "${redb}║%s║${nc}\n" "$(align::left $COLS_NUM " q  -  Выход")"
        printf "${redb}╚%s╝${nc}\n" "$(align::center $COLS_NUM "$equals")"
        _read_choice choice
        printf "${bnc}"

        if [[ "$mType" != "main" ]] && [[ "$choice" == "0" ]]; then
            echo
            printf '    %s\n\n' "$(cecho sY "Возврат.")"
            return 0
        fi

        if [[ "$choice" == "q" ]]; then
            printf "\n    ${bred}%s\n${nc}\n" "Выход."
            rm -f $PROJ_LOCK_FILE
            exit 0
        fi

        if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#mActions[@]} )); then
            "${mActions[choice - 1]}"
            if [[ "$mType" == "section" ]] && [[ "$choice" != "0" ]]; then
                menu_pause
            elif [[ "$mType" == "select" ]]; then
                return 0
            else
                _flush_stdin
            fi
        else
            local enterExit="\n    Для выхода введите \"${byel}q${bmag}\"."
            if [[ "$mType" == "main" ]]; then
                backOrExit=${enterExit}
            else
                backOrExit="\n    Либо введите \"${byel}0${bmag}\" для возврата пердыдущее меню.${enterExit}"
            fi
            printf "\n${bmag}    Введите число от \"${byel}1${bmag}\" до \"${byel}%d${bmag}\".${backOrExit}${nc}\n\n" ${index}
            menu_pause
        fi
        wg_header
    done
}

### Динамическое меню выбора:
select_menu() {
    while true; do
        local choice
        local index=0
        local def_num=$((${sDefault} - 1))
        echo
        printstr '%s\n' "${sTitle}"
        for idx in ${!sItems[@]}; do
            if [[ "${idx}" == "${def_num}" ]]; then
                printselect "$((idx + 1))" "${sItems[$idx]}" "по умолчанию"
            else
                printselect "$((idx + 1))" "${sItems[$idx]}"
            fi
            index=$((index + 1))
        done
        _read_choice choice

        [[ "$choice" == "0" ]] && log_cancel; return 1

        if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#sActions[@]} )); then
            "${sActions[choice - 1]}"
                return 0
        else
            local enterReturn="$(cecho sM "Для отмены введите \"")$(cecho sY "0")$(cecho sM "\".")"
            echo
            printf "    $(cecho sM "Введите число от \"")$(cecho sY 1)$(cecho sM "\" до \"")$(cecho sY "%d")$(cecho sM "\".")\n${enterReturn}\n\n" ${index}
            menu_pause
        fi
    done
}
