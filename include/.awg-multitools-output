# Выравнивание ячейки по ШИРИНЕ В СИМВОЛАХ. printf считает байты, поэтому колонка с кириллицей съезжает ровно на число многобайтовых символов.
_cols_pad() {
    local s="$1" w="$2" chars bytes
    chars=${#s}
    bytes=$(LC_ALL=C printf '%s' "$s" | wc -c)
    printf '%-*s ' "$((w + bytes - chars))" "$s"
}

align::left() {
  local -i width=${1:?}
  local -- str=${2:?}
#  local clr_str="$2"
  local -i length=$((${#str} > width ? width : ${#str}))
  local -i pad_right=$((width - length))
  printf '%s%*s' "${str:0:length}" ${pad_right} ''
}
align::right() {
  local -i width=${1:?}
  local -- str=${2:?}
  local -i length=$((${#str} > width ? width : ${#str}))
  local -i offset=$((${#str} - length))
  local -i pad_left=$((width - length))
  printf '%*s%s' $pad_left '' "${str:offset:length}"
}
align::center() {
  local -i width=${1:?}
  local -- str=${2:?}
  local -i length=$((${#str} > width ? width : ${#str}))
  local -i offset=$(((${#str} - length) / 2))
  local -i pad_left=$(((width - length) / 2))
  local -i pad_right=$((width - length - pad_left))
  printf '%*s%s%*s' $pad_left '' "${str:offset:length}" $pad_right ''
}

