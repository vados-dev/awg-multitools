# multiselect - это чисто bash-реализация меню с несколькими вариантами выбора.
# Если в качестве первого аргумента передается значение "true", то выводится справка будет напечатана до отображения параметров.
# Любое другое значение скроет его. Результат будет сохранен в виде массива в переменной,
# которая передается в multiselect в качестве второго аргумента. Третий аргумент принимает массив, содержащий все доступные параметры.
# Четвёртый аргумент необязателен и может использоваться для предварительного выбора определенных параметров.
# Если он используется, то это должен быть массив, который имеет значение "true" для каждого индекса параметров массива, который должен быть предварительно выбран.
# Пятый аргумент строка запроса.
#
# Пример:
#########
# arr_list=("Option 1" "Option 2" "Option 3")
# preselection=("true" "true" "false"), либо false если выбор не требуется
# med_multiselect "true" result _list preselection "Выберите опции"
#
# Обработка результата:
#    idx=0
#    ret_val=()
#    for option in "${arr_list[@]}"; do
#        [ "${result[idx]}" = true ] && ret_val+=("${option}")
#        ((idx++))
#    done
# В результате будет наполнен массив "ret_val()" с выбранными пунктами
######################################################################
med_multiselect() {
    local help_flag=$1 return_value=$2; local -n options=$3
    local -n defaults=$4; local prompt="$5"
    local legend=$(mini_legend "$help_flag"); local selected=()
    printf '    %s%s:\n' "$prompt" "$legend"
    for ((i = 0; i < ${#options[@]}; i++)); do
        [[ ${defaults[i]} = "true" ]] && selected+=("true") || selected+=("false")
        printf "\n"
    done
    local lastrow=$(get_cursor_row)
    local startrow=$(($lastrow - ${#options[@]}))
    trap "cursor_blink_on; stty echo; printf '\n'; exit" 2
    cursor_blink_off
    toggle_option() {
        local option=$1
        [[ ${selected[option]} == true ]] && selected[option]=false || selected[option]=true
    }
    print_options() {
        local idx=0
        for option in "${options[@]}"; do
            local prefix="$sym_unsel"
            [[ ${selected[idx]} == true ]] && prefix="$sym_sel"
            cursor_to "$((startrow + idx))"
            [ "$idx" -eq "$1" ] && print_active "$option" "$prefix" || print_inactive "$option" "$prefix"
            ((idx++))
        done
    }
    to_exit() { cursor_to "$lastrow"; printf "\n"; cursor_blink_on; }
    local active=0
    while true; do
        print_options "$active"
        case $(key_input) in
        space) toggle_option "$active" ;;
        enter)
            print_options -1
            break ;;
        up)
            ((active--))
            ((active < 0)) && active=$(( ${#options[@]} - 1 )) ;;
        down)
            ((active++))
            ((active >= ${#options[@]})) && active=0 ;;
        cancel)
            to_exit; log_cancel; return 1 ;;
        esac
    done
#    set +x
    to_exit
    eval "$return_value"='("${selected[@]}")'
}

### Менюшка выбора одной опции (галочкой):
#-> Использование:
# single_select_menu "true" result array default_value "Текст запроса"
# Где:
#      $1 - выводить ли легенду ("true" или "false")
#      $2 - что вернёт (прямо так, без бакса)
#      $3 - из чего выбирать (прямо так, без бакса)
#      $4 - выбрано по умолчанию
#      $5 - текст запроса (если включена легенда, она будет добавлена в скобках к тексту запроса)
#
# Пример:
#########
# single_select_menu "true" result array 2 "Выберите одну опцию"
# Обработка результата: просто возврат переменной ($result).

single_select() {
    local help_flag=$1 return_value=$2; local -n options=$3
    local default_selection="${4:-0}" prompt="$5"
    local legend=$(mini_legend "$help_flag")
    printf '    %s%s:\n' "$prompt" "$legend"
    for ((i = 0; i < ${#options[@]}; i++)); do
        printf "\n"
    done
    local lastrow=$(get_cursor_row)
    local startrow=$(($lastrow - ${#options[@]}))
    trap "cursor_blink_on; stty echo; printf '\n'; exit" 2
    cursor_blink_off
    print_options() {
        local idx=0
        for option in "${options[@]}"; do
            local prefix="$sym_unsel"
            [[ $idx -eq $selected ]] && prefix="$sym_sel"
            cursor_to "$((startrow + idx))"
            [ "$idx" -eq "$active" ] && print_active "$option" "$prefix" || print_inactive "$option" "$prefix"
            ((idx++))
        done
    }

    to_exit() { cursor_to "$lastrow"; printf "\n"; cursor_blink_on; }
    local selected=$default_selection
    local active=0
    while true; do
        print_options "$active"
        case $(key_input) in
        space)
            if [ "$active" -eq "$selected" ]; then
                selected=-1
            else
                selected=$active
            fi
            ;;
        enter)
            local active=-1
            print_options "$active"
            break
            ;;
        up)
            ((active--))
            ((active < 0)) && active=$(( ${#options[@]} - 1 ))
            ;;
        down)
            ((active++))
            ((active >= ${#options[@]})) && active=0
            ;;
        cancel)
            to_exit; log_cancel; return 1 ;;
        esac
    done
    cursor_to "$lastrow"
    printf "\n"
    cursor_blink_on
    if [ "$selected" -eq -1 ]; then
        eval "$return_value"='("")'
    else
        eval "$return_value"='"${options[$selected]}"'
    fi
}

