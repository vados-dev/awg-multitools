key_input() {
    local key
    IFS= read -rsn1 key 2>/dev/null >&2
    if [[ $key = ""      ]]; then echo enter; fi;
    if [[ $key = $'\x20' ]]; then echo space; fi;
#    if [[ $key = $'\e[F' ]]; then echo end; fi;
#    if [[ $key = $'\e[H' ]]; then echo home; fi;
#    if [[ $key = $'\x7f' ]]; then echo backspace; fi;
#    if [[ $key = $'\x1b\x5b\x32\x7e' ]]; then echo insert; fi;
#    if [[ $key = $'\x1b\x5b\x35\x7e' ]]; then echo pgup; fi;
#    if [[ $key = $'\x1b\x5b\x36\x7e' ]]; then echo pgdown; fi;
    if [[ $key = "k" ]]; then echo up;    fi;
    if [[ $key = "j" ]]; then echo down;  fi;
    if [[ $key = "h" ]]; then echo left;  fi;
    if [[ $key = "l" ]]; then echo right; fi;
    if [[ $key = "a" ]]; then echo all;   fi;
    if [[ $key = "n" ]]; then echo none;  fi;
    if [[ $key = "0" ]]; then echo cancel;  fi;
    if [[ $key = $'\x1b' ]]; then
        read -rsn2 key
#        if [[ $key = '' || $key = 0 ]]; then echo cancel; fi;
        if [[ $key = [A || $key = k ]]; then echo up;     fi;
        if [[ $key = [B || $key = j ]]; then echo down;   fi;
        if [[ $key = [C || $key = l ]]; then echo right;  fi;
        if [[ $key = [D || $key = h ]]; then echo left;   fi;
    fi
}

