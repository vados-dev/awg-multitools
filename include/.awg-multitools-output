printstr() {
    local _head="$(app_title)";
    if [[ "$#" == 4 ]]; then
       printf "$(cecho sW "$_head") %s $2$(cecho sW "$1")$(cecho sY "$3")\n" "$4";
    elif [[ "$#" == 3 ]]; then
       printf "$(cecho sW "$_head") %s $(cecho sW "$1")$(cecho sY "$2")\n" "$3";
    elif [[ "$#" == 2 ]]; then
       printf "$(cecho sW "$_head") %s $(cecho sW "$1")\n" "$2";
    else
       printf "$(cecho sW "$_head") $(cecho sW "%s")\n" "$1";
    fi
}

printselect() {
    local _start='    ';
    if [[ "$#" == 3 ]]; then
       printf "$(cecho sW "$_start") $(cecho sY "%s")$(cecho sW ") -") $(cecho sG "%s") $(cecho sW "(%s)")\n" "$1" "$2" "$3";
    elif [[ "$#" == 2 ]]; then
       printf "$(cecho sW "$_start") $(cecho sM "%s")$(cecho sW ") - %s")\n" "$1" "$2";
#    else
#       printf "$(cecho sW "$_head") $(cecho sW "%s")\n" "$1";
    fi
}


### Функции логирования:
########################
log_msg() {
    local type="$1";local msg="$2";
    local ts=$(date '+%b %d %T');
    local entry="[${ts}] ${type}: ${msg}";
    local existed=1
    [[ -f "${LOG_FILE}" ]] || existed=0
    case "$type" in
        info)      printstr "$(cecho sB 'Инфо: ')$(cecho sW "${msg}")" "${sym_info}" ;;
        ok)        printstr "$(cecho sG 'Ок: ')$(cecho sW "${msg}")" "${sym_ok}" ;;
        confirmed) printstr "$(cecho sG 'Подтверждено.')" "${sym_ok}" ;;
        cancelled) printstr "$(cecho sY 'Отменено.')" "${sym_cancel}" ;;
        warning)   printstr "$(cecho sY 'Внимание: ')$(cecho sW "${msg}")" "${sym_warn}" ;;
        save)      printstr "$(cecho sG 'Сохраню ')$(cecho sW "${msg}")" "${sym_ok}" ;;
        delete)    printstr "$(cecho sR 'Удалю ')$(cecho sW "${msg}")" "${minus}" ;;
        error)     printstr "$(cecho sR 'Ошибка: ')$(cecho sW "${msg}")" "${sym_err}" ;;
        debug)     printstr "$(cecho sW 'Отладка: ')$(cecho sW "${msg}")" "${sym_dbg}" ;;
        *) app_title "Error" "${sym_err}" ;;
    esac
    if [[ "${DEFAULT_LOG}" != "" ]] && [[ "${SAVE_LOG}" == true ]];then
        local log="${DEFAULT_LOG}";
        if ! mkdir -p "$(dirname "${log}")" || ! echo ${entry} >> "${log}"; then
            printstr "Ошибка записи лога '${log}'. $(cecho sR 'ERROR: ')" "${entry}" "${sym_err}";
            exit 1;
        fi
        # Скрипт работает под root, а каталог принадлежит admin: свежесозданный лог иначе останется root-овым и станет недоступен на запись без sudo.
        [[ "${existed}" -eq 0 && -f "${LOG_FILE}" ]] && _fix_owner "${LOG_FILE}"
    fi
}

