####################
### Цвета и символы:
####################
#┌───────┬────────────────┬─────────────────┐┌───────┬─────────────────┬───────┐
#│ Fg/Bg │ Color          │ Octal           ││ Code  │ Style           │ Octal │
#├───────┼────────────────┼─────────────────┤├───────┼─────────────────┼───────┤
#│  K/k  │ Black          │ \e[ + 3/4  + 0m ││  s/S  │ Bold (strong)   │ \e[1m │
#│  R/r  │ Red            │ \e[ + 3/4  + 1m ││  d/D  │ Dim             │ \e[2m │
#│  G/g  │ Green          │ \e[ + 3/4  + 2m ││  i/I  │ Italic          │ \e[3m │
#│  Y/y  │ Yellow         │ \e[ + 3/4  + 3m ││  u/U  │ Underline       │ \e[4m │
#│  B/b  │ Blue           │ \e[ + 3/4  + 4m ││  f/F  │ Blink (flash)   │ \e[5m │
#│  M/m  │ Magenta        │ \e[ + 3/4  + 5m ││  n/N  │ Negative        │ \e[7m │
#│  C/c  │ Cyan           │ \e[ + 3/4  + 6m ││  h/H  │ Hidden          │ \e[8m │
#│  W/w  │ White          │ \e[ + 3/4  + 7m ││  t/T  │ Strikethrough   │ \e[9m │
#├───────┴────────────────┼─────────────────┤├───────┼─────────────────┼───────┤
#│  High intensity        │ \e[ + 9/10 + *m ││   0   │ Reset           │ \e[0m │
#└────────────────────────┴─────────────────┘└───────┴─────────────────┴───────┘
#                                             Uppercase = Reset a style: \e[2*m
################################################################################
_c() { [ $# == 0 ] && printf "\e[0m" || printf "$1" | sed 's/\(.\)/\1;/g;s/\([SDIUFNHT]\)/2\1/g;s/\([KRGYBMCW]\)/3\1/g;s/\([krgybmcw]\)/4\1/g;y/SDIUFNHTsdiufnhtKRGYBMCWkrgybmcw/12345789123457890123456701234567/;s/^\(.*\);$/\\e[\1m/g'; }

nc=$(_c); bld=$(echo -en $(_c s)); sma=$(echo -en $(_c d)); und=$(echo -en $(_c u)); strt=$(echo -en $(_c t));
bnc=$(_c 0s);

if [ -t 0 ] && ! $NO_COLOR; then
    cecho() { echo -en "$(_c $1)${2:-}\e[0m"; }
    blk=$(_c K); red=$(_c R); grn=$(_c G); yel=$(_c Y); blu=$(_c B); mag=$(_c M); cy=$(_c C); wh=$(_c W);
    bblk=$(_c sK); bred=$(_c sR); bgrn=$(_c sG); byel=$(_c sY); bblu=$(_c sB); bmag=$(_c sM); bcy=$(_c sC); bwh=$(_c sW);
    blkb=$(_c sWk); redb=$(_c sWr); grnb=$(_c hBg); yelb=$(_c By); blub=$(_c sWb); magb=$(_c sWm); cyb=$(_c Kc); whb=$(_c Kw);
    blkB=$(_c sfW); redB=$(_c sfWr); grnB=$(_c fBg); yelB=$(_c fBy); bluB=$(_c sfWb); magB=$(_c sfWm); cyB=$(_c fKc); whB=$(_c sfWk);
    rev=$(tput rev); blink=$(_c f); neg=$(_c n);
    sym_ok=$(cecho Gs √); sym_cancel=$(cecho sR ❌); sym_err=$(cecho Rf ❌); install=$(cecho s 💿); sym_install=$(cecho sG 📦); sym_warn_old=$(cecho sY ⚠⚠); sym_warn=$(cecho sY ⚡);
    sym_info=$(cecho Bs 📋); sym_docs=$(cecho sW 📖); sym_dbg=$(cecho sW 🔧); sym_star=$(cecho sY ✨); sym_search=$(cecho s 🔍); sym_sec=$(cecho sR 🧱);
    sym_hand=$(cecho sY 👉); sym_service=$(cecho s 🛠🛠); sym_door=$(cecho s 🛡️); minus=$(cecho Rf —); plus=$(cecho Gs +); sym_sel=$(cecho Gs ✅); sym_unsel='❎'; warn=$(cecho sY ▲);
    arr_right=$(cecho s →); arr_left=$(cecho s ←); arr_up=$(cecho s ↑); arr_down=$(cecho s ↓); arr_gor=$(cecho sW ↔); arr_vert=$(cecho sW ↕); zamok=$(cecho sR 🔒);
else
    cecho() { echo -n "${2}"; }
    neg=''; blink=''; rev='';
    blk=''; red=''; grn=''; yel=''; blu=''; mag=''; cy=''; wh='';
    blkb=''; redb=''; grnb=''; yelb=''; blub=''; magb=''; cyb=''; whb='';
    bblk=''; bred=''; bgrn=''; byel=''; bblu=''; bmag=''; bcy=''; bwh='';
    sym_ok='√'; sym_cancel='❌'; sym_err='❌'; install='💿';  sym_install='📦'; sym_info='📋'; sym_docs='📖';
    sym_warn_old='⚠⚠'; sym_warn='⚡'; sym_dbg='🔧'; sym_star='✨'; sym_search='🔍'; sym_sec='🧱';
    sym_hand='👉'; sym_service='🛠🛠'; sym_door='🛡️'; minus='—'; plus='+'; sym_sel='✅'; sym_unsel='❎'; warn='▲';
    arr_right='→'; arr_left='←'; arr_up='↑'; arr_down='↓'; arr_gor='↔'; arr_vert='↕'; zamok='🔒';
fi

