bad_auto_log() {
    local _run="$1"; local delay=0.15
    custom_spin_max_time="${2:-$spin_max_time}"
    custom_spin_color="${3:-$spin_color}"
    unset_spin(){ clnstr; unset custom_spin_color; unset custom_spin_max_time; }
    local tmp=$(mktemp);
    "$_run" >"$tmp" 2>&1 &
    local pid=$!
    local name
    if [[ -z "$name" ]] 2>/dev/null; then name="$_run"; else name=$(ps a "$pid" -o comm= 2>/dev/null || echo -en "Процесс с PID ${pid} не найден."); fi
    local frames=("$(cecho ${custom_spin_color} '|')" "$(cecho ${custom_spin_color} '/')" "$(cecho ${custom_spin_color} '-')" "$(cecho ${custom_spin_color} '\\')")
#    local max_ticks="$(( ${custom_spin_max_time} / ${delay} ))"
    local max_ticks=$(awk "BEGIN{printf \"%d\", (${custom_spin_max_time} / ${delay})}")
    local i=0 tick=0
    tput civis --
    while kill -0 "$pid" > /dev/null 2>&1; do
        printstr "\rВыполнение: ${name} - ${frames[i]}"
        i=$(( (i + 1) % 4 ))
        sleep "$delay"
        ((tick++))
        if (( tick >= max_ticks )); then
            kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null || true
            local out=$(<"$tmp"); rm -f "$tmp"
            unset_spin
            log_msg "spin_warn" "${name} - $_run${out:+ : $out}"
        fi
        printf '\b\b\b\b\b'
    done
#    printf "\b\b\b$(clnstr)\b\b\b"
    wait "$pid"; local rc=$?
    local out=$(<"$tmp"); rm -f "$tmp"
    if (( rc == 0 )); then
        log_msg "spin_ok" "    ${name} - $_run${out:+ : $out}"
    else
        log_msg "spin_err" "    ${name} - $_run (код $rc)${out:+ : $out}" >&2
    fi
    unset_spin
    return "$rc"
    tput cnorm --
}

spinstr() {
    local _run="$1"; local delay=0.1
    custom_spin_max_time="${2:-${spin_max_time}}"
    custom_spin_color="${3:-${spin_color}}"
    unset_spin(){ clnstr; unset custom_spin_color; unset custom_spin_max_time; }
    "$_run" &
    local pid=$!; local name="$4"
    if [[ -z "$name" ]] 2>/dev/null; then name="$_run"; else name=$(ps -p "$pid" -o comm= 2>/dev/null || { echo -en "Процесс с PID ${pid} не найден."; return 1; }); fi
    local frames=("$(cecho ${custom_spin_color} '|')" "$(cecho ${custom_spin_color} '/')" "$(cecho ${custom_spin_color} '-')" "$(cecho ${custom_spin_color} '\\')")
    local max_ticks=$(awk "BEGIN{printf \"%d\", (${custom_spin_max_time} / ${delay})}")
    local i=0 tick=0
    while kill -0 "$pid" 2>/dev/null; do
        printf "\r%s $_run [$name]...   " "${frames[i]}"
        i=$(( (i + 1) % 4 ))
        sleep "$delay"
        ((tick++))
        if (( tick >= max_ticks )); then
            kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null || true
            unset_spin; clean_str

            return 13
        fi
    done
    wait "$pid"; local rc=$?; unset_spin; return "$rc"
}

