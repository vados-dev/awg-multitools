bad_spinstr() {
    local msg="${1:-}"; shift
    local color="${spin_color}"
    local sym
    # Опционально --color <cecho-код> #[[ "${1:-}" == "--color" ]] && color="$2"; shift 2;
    # Запускаем команду в фоне
    "$@" &
    local -r pid=$!
    # Имя процесса по PID
    local name=$(ps -p "$pid" -o comm= 2>/dev/null || { log_warn "Процесс с PID ${pid} не найден."; return 1; })
    # Если процесс не стартанул — сразу в failure_box
    kill -0 "$pid" 2>/dev/null || { failure_box "$msg"; return 1; }
    # Заранее красим кадры через cecho (один раз, не в цикле)
    local frames=(
        "$(cecho "$col" '|')"
        "$(cecho "$col" '/')"
        "$(cecho "$col" '-')"
        "$(cecho "$col" '\')"
    )
    # Крутим, пока жив
    local i=0
    while kill -0 "$pid" 2>/dev/null; do
        printf "\r%s %s...   " "${frames[i]}" "$msg"
        i=$(( (i + 1) % 4 ))
        sleep 0.15
    done
    # Ловим код возврата
    wait "$pid"
    local rc=$?
    # Стираем строку спиннера
    printf "\r\033[K"
    # Результат
    if (( rc == 0 )); then
        printf "%s %s\n" "$spin_ok" "$msg"
        ok_box "$msg"
    else
        printf "%s %s\n" "$spin_err" "$msg"
        failure_box "$msg"
    fi
    return $rc
}

