### Forward ports (проброс портов):
###################################
# Действия: --add, --remove, --list
# Формат: port=proto:toaddr:toport
FW_Forward() {
  local action="$1" zone="$2" port="$3" proto="$4" toport="$5" toaddr="$6" dbg="${DBG:-0}"
  [ "$dbg" -eq 1 ] && log_debug "$? $*"
  case "$action" in
    --add)
      local fwd="port=${port}:${proto}"
      [[ -n "$toport"  ]] && fwd+=":toport=${toport}"
      [[ -n "$toaddr"  ]] && fwd+=":toaddr=${toaddr}"
      fw $perm --zone="${zone:-public}" --add-forward-port="$fwd"
      [[ "$allReload" -eq 1 ]] && fwreload || true
      ;;
    --remove)
      local fwd="port=${port}:${proto}"
      [[ -n "$toport"  ]] && fwd+=":toport=${toport}"
      [[ -n "$toaddr"  ]] && fwd+=":toaddr=${toaddr}"
      fw $perm --zone="${zone:-public}" --remove-forward-port="$fwd"
      [[ "$allReload" -eq 1 ]] && fwreload || true
      ;;
    --list)
      fw --zone="${zone:-public}" --list-forward-ports
      ;;
    *)
      echo "Использование: FW_Forward <--add|--remove|--list> [zone] [port] [tcp|udp] [toport] [toaddr]"
      return 1
      ;;
  esac
}

