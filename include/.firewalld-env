### FW_Set_MSS:
###############
# Использование:
# FW_Set_MSS                    # pmtu (авто), зона public
# FW_Set_MSS internal           # pmtu (авто), зона internal
# FW_Set_MSS public 1380        # фиксированный MSS=1380, зона public
# FW_Set_MSS VPN-clients 1360    # для VPN-зоны

FW_Set_MSS() {
  local zone="${1:-public}"
  local mss="$2"   # пусто = pmtu (авто), число = фиксированный MSS
  local rule='rule tcp-mss-clamp'
  [[ -n "$mss" ]] && rule="rule tcp-mss-clamp value=$mss"
  fw $perm --zone="$zone" --add-rich-rule="$rule"
  fwreload
  if [[ -n "$mss" ]]; then
    success_box "MSS=$mss в зоне $zone"
  else
    success_box "MSS=pmtu (авто) в зоне $zone"
  fi
}

### Panic mode
########################################
FW_Panic() {
  local action="$1"
  case "$action" in
    --on)  fw --panic-on  ;;
    --off) fw --panic-off ;;
    --query) fw --query-panic ;;
    *) echo "Использование: FW_Panic <--on|--off|--query>"; return 1 ;;
  esac
}

### Логи и состояние
########################################
FW_State() {
  local action="${1:---state}"
  case "$action" in
    --state)      fw --state ;;
    --list-all)   fw --zone="${2:-public}" --list-all ;;
    --list-all-zones) fw --list-all-zones ;;
    --get-default) fw --get-default-zone ;;
    *)
      echo "Использование: FW_State <--state|--list-all [zone]|--list-all-zones|--get-default>"
      return 1
      ;;
  esac
}
