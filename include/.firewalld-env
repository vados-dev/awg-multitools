# firewalld management — env-файл с функциями-обёртками над firewall-cmd
# Подразумевает наличие: success_box, failure_box, log_error, log_debug, cecho
#############################################################################
# Примеры вызовов:
#-> Создать зону с описанием
# FW_Zone --new myzone "My Zone" "Для тестов"
#-> Добавить сервис в зону
# FW_Service --add public http
#-> Добавить порт
# FW_Port --add public 8080 tcp
#-> Проверить, открыт ли порт 80/tcp где-либо
# FW_Port --check "" 80 tcp
#-> Добавить rich rule
# FW_RichRule --add public 'rule family="ipv4" source address="192.168.1.0/24" accept'
#-> Включить masquerade
# FW_Masquerade --add public
#-> Проброс порта
# FW_Forward --add public 80 tcp 8080 192.168.1.100
#-> Создать IPSet
# FW_IPSet --new blacklist hash:ip
# FW_IPSet --add-entry blacklist 1.2.3.4
#-> Panic mode
# FW_Panic --on

### Переменные
########################################
FW_RUN="${FW_RUN:-$(command -v firewall-cmd 2>/dev/null)}"
perm="--permanent"
allReload=0

### Базовая обёртка: выполняет firewall-cmd, печатает ошибки, рамки по итогу
########################################
fw() {
  local output
  output=$($FW_RUN "$@" 2>&1)
  # Если это не чистый "success" — показываем вывод (ошибки/предупреждения)
  [[ "$output" != "success" ]] && echo "$output"
  # Проверяем успех и рамку
  if echo "$output" | grep -q 'success'; then
    success_box "$FW_RUN $*"
  else
    log_error "${FW_RUN}\n$*\n${output}"
  fi
}

# Сокращение для reload
fwreload() { fw --reload; }
# Полный reload (сбрасывает также ICMP-настройки)
fwreload_full() { fw --complete-reload; }

# Перенос runtime → permanent (если правило добавлено только в runtime)
fwruntime2perm() { fw --runtime-to-permanent; }

### Проверки
########################################

# Проверить порт везде: прямые порты + порты внутри сервисов, runtime + permanent
FW_check_port() {
  local port="$1" found=1
  for mode in "" "$perm"; do
    for zone in $($FW_RUN $mode --get-zones 2>/dev/null); do
      # Прямой порт в зоне
      if $FW_RUN $mode --zone="$zone" --list-ports 2>/dev/null | grep -qw "$port"; then
        found=0; break 2
      fi
      # Порт внутри сервиса
      for svc in $($FW_RUN $mode --zone="$zone" --list-services 2>/dev/null); do
        if $FW_RUN $mode --service="$svc" --get-ports 2>/dev/null | grep -qw "$port"; then
          found=0; break 3
        fi
      done
    done
  done
  return "$found"
}

# Проверить сервис везде (runtime + permanent)
FW_check_service() {
  local svc="$1" found=1
  for mode in "" "$perm"; do
    for zone in $($FW_RUN $mode --get-zones 2>/dev/null); do
      $FW_RUN $mode --zone="$zone" --list-services | grep -oq "$svc" 2>/dev/null && found=0; break 2 || found=1; break
    done
  done
  return "$found"
}

# Проверить интерфейс в зоне (runtime + permanent)
FW_check_interface() {
  local iface="$1" found=1
  for mode in "" "$perm"; do
    for zone in $($FW_RUN $mode --get-zones 2>/dev/null); do
      if $FW_RUN $mode --zone="$zone" --list-interfaces 2>/dev/null | grep -qw "$iface"; then
        found=0; break 2
      fi
    done
  done
  return "$found"
}

# Проверить source IP/подсеть в зонах (runtime + permanent)
FW_check_source() {
  local src="$1" found=1
  for mode in "" "$perm"; do
    for zone in $($FW_RUN $mode --get-zones 2>/dev/null); do
      if $FW_RUN $mode --zone="$zone" --list-sources 2>/dev/null | grep -qw "$src"; then
        found=0; break 2
      fi
    done
  done
  return "$found"
}

#-> FW_Direct — универсальный direct rule
FW_Direct() {
  local action="$1" family="$2" table="$3" chain="$4" prio="$5"
  shift 5
  case "$action" in
    --add)
      $fw $perm --direct --add-rule "$family" "$table" "$chain" "$prio" "$@"
      [[ "$allReload" -eq 1 ]] && fwreload || true
      ;;
    --remove)
      $fw $perm --direct --remove-rule "$family" "$table" "$chain" "$prio" "$@" 2>/dev/null || true
      [[ "$allReload" -eq 1 ]] && fwreload || true
      ;;
    *)
      echo "Использование: FW_Direct <--add|--remove> <ipv4|ipv6> <table> <chain> <prio> <rule...>"
      return 1
      ;;
  esac
}


### Зоны
########################################
# Действия: --new, --delete, --info, --list, --get-zones, --get-default, --get-active, --set-default
# --get:
# FW_Zone --get zones
# FW_Zone --get default
# FW_Zone --get active
# FW_Zone --get interface eth0
# FW_Zone --get source 192.168.1.0/24
FW_Zone() {
  local action="$1" name="$2" short="$3" desc="$4" dbg="${DBG:-0}"
  [ "$dbg" -eq 1 ] && log_debug "$? $*"
  case "$action" in
    --new)
      fw $perm --new-zone="$name"
      [[ -n "$short" ]] && fw $perm --zone="$name" --set-short="$short"
      [[ -n "$desc"  ]] && fw $perm --zone="$name" --set-description="$desc"
      [[ "$allReload" -eq 1 ]] && fwreload || true
      ;;
    --delete)
      fw $perm --delete-zone="$name"
      [[ "$allReload" -eq 1 ]] && fwreload || true
      ;;
    --info)
      fw $perm --info-zone="${name:-public}"
      ;;
    --list)
      if [[ -n "$name" ]]; then
        fw --list-all-zones | sed -n "/^${name}/,/^$/p"
      else
        fw --list-all-zones
      fi
      ;;
    --get)
      local subcmd="$name"   # $2
      case "$subcmd" in
        zones)
          fw --get-zones
          ;;
        default)
          fw --get-default-zone
          ;;
        active)
          fw --get-active-zones
          ;;
        interface)
          fw --get-zone-of-interface="$short"   # $3 = имя интерфейса
          ;;
        source)
          fw --get-zone-of-source="$short"      # $3 = IP/подсеть
          ;;
        *)
          echo "Использование: FW_Zone --get <zones|default|active|interface|source> [имя]"
          return 1
47          ;;
      esac
      ;;
    --set-default)
      fw $perm --set-default-zone="${name:-public}"
      [[ "$allReload" -eq 1 ]] && fwreload || true
      ;;
    *)
      echo "Использование: FW_Zone <--new|--delete|--info|--list|--get-zones|--get-default|--get-active|--set-default> [имя] [short] [desc]"
      return 1
      ;;
  esac
}

### Сервисы
########################################
# Действия: --add, --remove, --list, --info, --new, --delete, --add-port, --remove-port, --set-short, --set-desc
FW_Service() {
  local action="$1" zone="$2" svc="$3" dbg="${DBG:-0}"
  [ "$dbg" -eq 1 ] && log_debug "$? $*"

  case "$action" in
    --add)
      fw $perm --zone="$zone" --add-service="$svc"
      [[ "$allReload" -eq 1 ]] && fwreload || true
      ;;
    --remove)
      fw $perm --zone="$zone" --remove-service="$svc"
      [[ "$allReload" -eq 1 ]] && fwreload || true
      ;;
    --list)
      fw --zone="${zone:-public}" --list-services
      ;;
    --info)
      fw --info-service="${svc:-http}"
      ;;
    --get-all)
      fw --get-services
      ;;
    --new)
      fw $perm --new-service="$svc"
      [[ "$allReload" -eq 1 ]] && fwreload || true
      ;;
    --delete)
      fw $perm --delete-service="$svc"
      [[ "$allReload" -eq 1 ]] && fwreload || true
      ;;
    --add-port)
      fw $perm --service="$svc" --add-port="$4"
      [[ "$allReload" -eq 1 ]] && fwreload || true
      ;;
    --remove-port)
      fw $perm --service="$svc" --remove-port="$4"
      [[ "$allReload" -eq 1 ]] && fwreload || true
      ;;
    --set-short)
      fw $perm --service="$svc" --set-short="$4"
      ;;
    --set-desc)
      fw $perm --service="$svc" --set-description="$4"
      ;;
    *)
      echo "Использование: FW_Service <--add|--remove|--list|--info|--get-all|--new|--delete|--add-port|--remove-port|--set-short|--set-desc> [zone] [service] [доп.арг]"
      return 1
      ;;
  esac
}

### Порты
########################################
# Действия: --add, --remove, --list, --check
FW_Port() {
  local action="$1" zone="$2" port="$3" proto="$4" dbg="${DBG:-0}"
  [ "$dbg" -eq 1 ] && log_debug "$? $*"
  case "$action" in
    --add)
      fw $perm --zone="$zone" --add-port="${port}/${proto}"
      [[ "$allReload" -eq 1 ]] && fwreload || true
      ;;
    --remove)
      fw $perm --zone="$zone" --remove-port="${port}/${proto}"
      [[ "$allReload" -eq 1 ]] && fwreload || true
      ;;
    --list)
      fw --zone="${zone:-public}" --list-ports
      ;;
    --check)
      if FW_check_port "${port}/${proto}"; then
        success_box "Порт ${port}/${proto} найден"
      else
        failure_box "Порт ${port}/${proto} не найден"
      fi
      ;;
    *)
      echo "Использование: FW_Port <--add|--remove|--list|--check> [zone] [port] [tcp|udp]"
      return 1
      ;;
  esac
}

